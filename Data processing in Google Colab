    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "from sklearn.model_selection import StratifiedKFold\n",
        "from sklearn.metrics import classification_report, accuracy_score, roc_auc_score\n",
        "import lightgbm as lgb\n",
        "import xgboost as xgb\n",
        "import joblib\n",
        "import json\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import label_binarize\n",
        "from itertools import cycle\n",
        "\n",
        "NUM_FOLDS = 5\n",
        "skf = StratifiedKFold(n_splits=NUM_FOLDS, shuffle=True, random_state=42)\n",
        "\n",
        "# LightGBM params (multiclass)\n",
        "params_lgb = {\n",
        "    'objective': 'multiclass',\n",
        "    'num_class': len(le.classes_),\n",
        "    'learning_rate': 0.05,\n",
        "    'num_leaves': 50,\n",
        "    'max_depth': 10,\n",
        "    'feature_fraction': 0.8,\n",
        "    'bagging_fraction': 0.8,\n",
        "    'bagging_freq': 5,\n",
        "    'lambda_l1': 0.2,\n",
        "    'lambda_l2': 0.2,\n",
        "    'verbosity': -1,\n",
        "    'seed': 42,\n",
        "    'class_weight': 'balanced'\n",
        "}\n",
        "\n",
        "oof_preds = np.zeros((X.shape[0], len(le.classes_)))\n",
        "fold = 0\n",
        "for train_idx, val_idx in skf.split(X, y):\n",
        "    fold += 1\n",
        "    print(f\"Fold {fold}\")\n",
        "    X_train, X_val = X[train_idx], X[val_idx]\n",
        "    y_train, y_val = y[train_idx], y[val_idx]\n",
        "    dtrain = lgb.Dataset(X_train, label=y_train)\n",
        "    dval = lgb.Dataset(X_val, label=y_val, reference=dtrain)\n",
        "\n",
        "    model = lgb.train(\n",
        "        params_lgb,\n",
        "        dtrain,\n",
        "        num_boost_round=2000,\n",
        "        valid_sets=[dtrain, dval],\n",
        "        callbacks=[lgb.early_stopping(stopping_rounds=100, verbose=100)]\n",
        "    )\n",
        "    preds = model.predict(X_val, num_iteration=model.best_iteration)\n",
        "    oof_preds[val_idx] = preds\n",
        "\n",
        "# final predictions\n",
        "y_pred = np.argmax(oof_preds, axis=1)\n",
        "print(\"Overall Accuracy:\", accuracy_score(y, y_pred))\n",
        "print(classification_report(y, y_pred, target_names=le.classes_))"
      ],
