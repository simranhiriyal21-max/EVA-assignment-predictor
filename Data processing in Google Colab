        "if 'short_description' in df.columns or 'description' in df.columns:\n",
        "    df['text'] = df.get('short_description', '').fillna('') + ' ' + df.get('description','').fillna('')\n",
        "else:\n",
        "    df['text'] = df[df.columns[1]].astype(str)  # fallback\n"
