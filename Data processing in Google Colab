    {
      "cell_type": "code",
      "source": [
        "# Create extra \"Security Team\" examples if count is low.\n",
        "target = 'Security Team'\n",
        "count = (df['assignment_group'] == target).sum()\n",
        "print(\"Existing Security Team examples:\", count)\n",
        "\n",
        "if count < 30:\n",
        "    extras = [\n",
        "      \"Antivirus expired\",\n",
        "      \"Virus detected on workstation\",\n",
        "      \"Malware alert from endpoint protection\",\n",
        "      \"Unable to connect to secure VPN\",\n",
        "      \"Phishing email reported by user\",\n",
        "      \"Unusual login detected from unknown IP\",\n",
        "      \"Security breach alert\",\n",
        "      \"Endpoint protection update failed\",\n",
        "      \"Antivirus not updating\",\n",
        "      \"Ransomware suspicious activity\"\n",
        "    ]\n",
        "    add_rows = []\n",
        "    for t in extras:\n",
        "        add_rows.append({\n",
        "            'INC_number': None,\n",
        "            'short_description': t,\n",
        "            'description': f\"User reports: {t}\",\n",
        "            'category': 'Security',\n",
        "            'assignment_group': target,\n",
        "            'text': t\n",
        "        })\n",
        "    aug_df = pd.DataFrame(add_rows)\n",
        "    df = pd.concat([df, aug_df], ignore_index=True)\n",
        "    df = shuffle(df, random_state=42).reset_index(drop=True)\n",
        "    print(\"After augmentation shape:\", df.shape)\n",
        "    print(df['assignment_group'].value_counts())\n",
        "else:\n",
        "    print(\"No augmentation needed.\")\n"
      ],
